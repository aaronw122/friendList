   351	</x-dc>
   352	<script type="text/x-dc" data-dc-script data-props="{&quot;$preview&quot;:{&quot;width&quot;:900,&quot;height&quot;:700},&quot;accentColor&quot;:{&quot;editor&quot;:&quot;color&quot;,&quot;default&quot;:&quot;#9B85F2&quot;,&quot;tsType&quot;:&quot;string&quot;,&quot;options&quot;:[&quot;#9B85F2&quot;,&quot;#B7A2FF&quot;,&quot;#8A6FE8&quot;,&quot;#7C6BD6&quot;],&quot;section&quot;:&quot;Look&quot;},&quot;showChatBubble&quot;:{&quot;editor&quot;:&quot;boolean&quot;,&quot;default&quot;:true,&quot;tsType&quot;:&quot;boolean&quot;,&quot;section&quot;:&quot;Onboarding scene&quot;},&quot;gravity&quot;:{&quot;editor&quot;:&quot;range&quot;,&quot;default&quot;:1.05,&quot;min&quot;:0.4,&quot;max&quot;:2,&quot;step&quot;:0.05,&quot;tsType&quot;:&quot;number&quot;,&quot;section&quot;:&quot;Onboarding scene&quot;}}">
   353	const CHATS = [
   354	  { name: "the boys", count: "48 links" },
   355	  { name: "brunch club", count: "31 links" },
   356	  { name: "Cabin Trip 2026", count: "12 links" },
   357	  { name: "roommates", count: "9 links" },
   358	  { name: "sunday runners", count: "6 links" },
   359	  { name: "Fam", count: "3 links" }
   360	];
   361	
   362	class Component extends DCLogic {
   363	  state = { step: 1, lists: [], sheetIn: false, access: false, pick: null, cid: "", sec: "", copied: false, name: "", desc: "Made from the group chat. Kept fresh by FriendList.", popped: false };
   364	
   365	  constructor(p) { super(p); this.stageRef = (el) => { this.stage = el; }; }
   366	
   367	  componentDidMount() { this.applyCta(); this.waitMatter(); }
   368	  componentDidUpdate() { this.applyCta(); }
   369	  componentWillUnmount() { this.dead = true; if (this.raf) cancelAnimationFrame(this.raf); if (this.timers) this.timers.forEach(clearTimeout); }
   370	
   371	  applyCta() { document.documentElement.style.setProperty("--fl-cta", this.props.accentColor || "#9B85F2"); }
   372	
   373	  waitMatter() {
   374	    if (this.dead) return;
   375	    if (window.Matter && this.stage) this.initPhysics();
   376	    else setTimeout(() => this.waitMatter(), 60);
   377	  }
   378	
   379	  initPhysics() {
   380	    const M = window.Matter;
   381	    const stage = this.stage;
   382	    const W = stage.clientWidth || 760, H = stage.clientHeight || 524;
   383	    const engine = M.Engine.create();
   384	    engine.gravity.y = this.props.gravity ?? 1.05;
   385	    this.engine = engine;
   386	    const world = engine.world;
   387	    const wallOpts = { isStatic: true, restitution: 0.4, friction: 0.6 };
   388	    M.Composite.add(world, [
   389	      M.Bodies.rectangle(W / 2, H + 40, W + 400, 80, wallOpts),
   390	      M.Bodies.rectangle(-40, H / 2, 80, H * 4, wallOpts),
   391	      M.Bodies.rectangle(W + 40, H / 2, 80, H * 4, wallOpts),
   392	      M.Bodies.rectangle(W / 2, -700, W + 400, 80, wallOpts)
   393	    ]);
   394	
   395	    const showBubble = this.props.showChatBubble ?? true;
   396	    let els = Array.from(stage.querySelectorAll("[data-obj]"));
   397	    els.forEach((el) => { if (el.dataset.obj === "bubble" && !showBubble) el.style.display = "none"; });
   398	    els = els.filter((el) => el.style.display !== "none");
   399	    this.items = [];
   400	
   401	    els.forEach((el, i) => {
   402	      const w = el.offsetWidth || 60, h = el.offsetHeight || 60;
   403	      const circle = el.dataset.shape === "circle";
   404	      const float = el.dataset.float === "1";
   405	      const x = 70 + Math.random() * (W - 140);
   406	      const y = -120 - Math.random() * 520;
   407	      const opts = { restitution: float ? 0.9 : 0.52, friction: 0.35, frictionAir: float ? 0.06 : 0.008, angle: (Math.random() - 0.5) * 1.2 };
   408	      const body = circle
   409	        ? M.Bodies.circle(x, y, w / 2, opts)
   410	        : M.Bodies.rectangle(x, y, w, h, Object.assign({ chamfer: { radius: Math.min(10, h / 3) } }, opts));
